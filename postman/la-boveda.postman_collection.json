    {
      "name": "2. Apertura por tiempo",
      "item": [
        {
          "name": "Crear secreto programado (abre en 5 s)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('secretoProgramadoId', pm.response.json().secreto.id);"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('fechaApertura', new Date(Date.now() + 5000).toISOString());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
