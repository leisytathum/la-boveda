              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Sufijo único para poder correr la colección varias veces sin chocar con emails repetidos",
                  "pm.collectionVariables.set('sufijo', Date.now());"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
