              "raw": "{\n  \"titulo\": \"Operación Atraco\",\n  \"contenido\": \"¡Nos robaron!\",\n  \"creadoPor\": 999,\n  \"solicitudes\": [\n    {\n      \"userId\": 2,\n      \"fecha\": \"2020-01-01T00:00:00Z\"\n    },\n    {\n      \"userId\": 3,\n      \"fecha\": \"2020-01-01T00:00:00Z\"\n    }\n  ]\n}",
