              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Agente A\",\n  \"email\": \"agentea_{{sufijo}}@boveda.com\",\n  \"password\": \"clave1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
